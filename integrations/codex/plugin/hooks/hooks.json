{
  "managedBy": "sdlc-manager-managed",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv --project \"__SDLC_MANAGER_ROOT__\" run --frozen python \"${PLUGIN_ROOT}/hooks/event.py\" SessionStart",
            "statusMessage": "Loading SDLC Manager context",
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv --project \"__SDLC_MANAGER_ROOT__\" run --frozen python \"${PLUGIN_ROOT}/hooks/event.py\" UserPromptSubmit",
            "statusMessage": "Reviewing SDLC Manager context",
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv --project \"__SDLC_MANAGER_ROOT__\" run --frozen python \"${PLUGIN_ROOT}/hooks/event.py\" PostToolUse",
            "statusMessage": "Reviewing SDLC Manager context",
            "additionalContextLimit": 1200
          }
        ]
      }
    ]
  }
}
