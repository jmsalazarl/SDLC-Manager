{
  "version": "v1",
  "hooks": [
    {
      "name": "sdlc-manager-file-save",
      "description": "Consulta SDLC Manager despues de guardar un archivo; no bloquea operaciones.",
      "trigger": "PostFileSave",
      "matcher": "\\.(py|yaml|yml|sql)$",
      "action": {
        "type": "command",
        "command": "uv run python integrations/kiro/kiro_event_adapter.py"
      },
      "timeout": 60,
      "enabled": false
    }
  ]
}
